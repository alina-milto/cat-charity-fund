# Database. SQLite works out of the box; the file is created on first run.
DATABASE_URL=sqlite+aiosqlite:///./fastapi.db

# Secret for signing JWT tokens, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET=

# OAuth token for Yandex Disk. Needed only for the report endpoint.
# YANDEX_DISK_TOKEN=your-yandex-disk-oauth-token
